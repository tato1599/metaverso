# ============================================================================
#  Configuración de PRODUCCIÓN (copia este archivo a deploy/.env y edítalo).
#  Es el ÚNICO archivo de entorno: lo usan la app, Caddy y PostgreSQL.
# ============================================================================

# ---- Dominio / URL pública (Caddy + Laravel) ----
APP_DOMAIN=metaverso.tuinstituto.tecnm.mx
APP_URL=https://metaverso.tuinstituto.tecnm.mx

# ---- Laravel ----
APP_NAME="Metaverso Escolar TecNM"
APP_ENV=production
APP_DEBUG=false
# Genera la llave con:  docker compose -f deploy/docker-compose.prod.yml run --rm app php artisan key:generate --show
APP_KEY=

# ---- Base de datos (PostgreSQL del contenedor) ----
DB_CONNECTION=pgsql
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=metaverso
DB_USERNAME=metaverso
DB_PASSWORD=CAMBIA-ESTA-CONTRASENA

# ---- Sesión / cache / colas en la BD (sin necesidad de Redis) ----
SESSION_DRIVER=database
CACHE_STORE=database
QUEUE_CONNECTION=database
# Importante para LTI cross-dominio sobre HTTPS:
SESSION_SECURE_COOKIE=true
SESSION_SAME_SITE=none

# ---- Parámetros del Metaverso ----
MAGIC_LINK_TTL_MINUTES=120
GAME_DEEPLINK_SCHEME=tecnm-metaverso
SANCTUM_TOKEN_TTL_MINUTES=480
LINKS_API_KEY=CAMBIA-ESTA-CLAVE
PANEL_LOGIN_TTL_MINUTES=30

# ---- Operación ----
# Ejecutar migraciones automáticamente al arrancar el contenedor:
RUN_MIGRATIONS=true
